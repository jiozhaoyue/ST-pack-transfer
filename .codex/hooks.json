{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python 'D:\\Repo\\Tavern-repo\\My-repo\\ST-zip-converter\\.codex\\hooks\\inject-subagent-context.py'",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python 'D:\\Repo\\Tavern-repo\\My-repo\\ST-zip-converter\\.codex\\hooks\\inject-subagent-context.py'",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python 'D:\\Repo\\Tavern-repo\\My-repo\\ST-zip-converter\\.codex\\hooks\\session-start.py'",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "python 'D:\\Repo\\Tavern-repo\\My-repo\\ST-zip-converter\\.codex\\hooks\\session-start.py'",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python 'D:\\Repo\\Tavern-repo\\My-repo\\ST-zip-converter\\.codex\\hooks\\session-start.py'",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .codex/hooks/session-start.py",
            "timeout": 30,
            "statusMessage": "Loading mini-trellis context",
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python 'D:\\Repo\\Tavern-repo\\My-repo\\ST-zip-converter\\.codex\\hooks\\inject-workflow-state.py'",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
