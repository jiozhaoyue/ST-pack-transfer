{
  "name": "st-pack-transfer",
  "version": "0.6.0",
  "description": "SillyTavern / Luker / PureTavern / TauriTavern 数据包转运工具",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.9.0",
    "fzstd": "^0.1.1"
  },
  "devDependencies": {
    "postcss": "8.5.26",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build --base=./",
    "build:offline": "node tooling/build-offline.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/run.cjs",
    "e2e:web": "node e2e/standalone/run.cjs",
    "e2e:instances": "node scripts/run-e2e-instances.cjs",
    "e2e:instance-pair": "node tooling/e2e-flows/instance-pair.cjs",
    "e2e:cloud-core": "node tooling/e2e-flows/cloud-core-e2e.cjs",
    "e2e:luker-tt": "node tooling/e2e-flows/luker-tt-roundtrip.cjs",
    "test:luker-tt": "vitest run test/luker-tt-roundtrip.test.js",
    "test:local-cloud": "vitest run test/local-cloud-contract.test.js",
    "cloud:serve:s3": "node tooling/local-cloud/s3-server.cjs",
    "cloud:serve:webdav": "node tooling/local-cloud/webdav-server.cjs",
    "check:css-scope": "node scripts/css-scope.js",
    "check:dom-injection": "node scripts/dom-injection-guard.js",
    "check:template-source": "node scripts/single-template-source.js",
    "check:dom-scope": "node scripts/dom-scope.js",
    "check:control-consumer": "node scripts/control-consumer-guard.js",
    "check:i18n": "node scripts/i18n-guard.js",
    "check:copy": "node scripts/copy-audit.js",
    "check:no-bundler-only": "node tooling/no-bundler-only.js",
    "check:docs-privacy": "node tooling/docs-privacy-guard.js",
    "check:ui-tokens": "node tooling/check-ui-tokens.mjs",
    "check:checkbox-centering": "node tooling/verify-checkbox-centering.cjs",
    "check:login-state": "node tooling/login-state-guard.mjs",
    "check:download-html": "node tooling/check-download-html.mjs",
    "check:ext-responsive": "node scripts/ui-verify-ext-responsive-cdp.cjs",
    "verify:rules": "node tooling/rules/run.mjs",
    "verify:all": "npm run verify:rules && npm test",
    "docs:verify": "node tooling/docs-sync.mjs --verify",
    "docs:update": "node tooling/docs-sync.mjs --update",
    "docs:shots": "node tooling/capture-docs-shots.cjs",
    "qa:static": "node tooling/qa-static.mjs",
    "shots:web": "node e2e/standalone/capture-ui-shots.cjs",
    "shots:instances": "node scripts/capture-instance-shots.cjs",
    "gen-fixtures": "node fixtures/gen.js"
  }
}
